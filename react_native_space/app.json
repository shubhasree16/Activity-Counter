{
  "expo": {
    "name": "Activity Counter App",
    "slug": "abacusai-mobile-apps",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.abacusai.activitycounter.t1791197654",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.abacusai.activitycounter.t1791197654",
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "abacusai1791197654",
              "host": "*"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "defaultChannel": "default",
          "color": "#FF1F8E"
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/CormorantGaramond_700Bold_Italic.ttf",
            "./assets/fonts/CormorantGaramond_600SemiBold.ttf"
          ],
          "widgets": [
            {
              "name": "WeeklyBoard",
              "label": "Weekly Board",
              "description": "Week date, your count and all five activities with tick boxes",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "500dp",
              "maxResizeHeight": "260dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-preview/weekly_board.png"
            },
            {
              "name": "WeekStrip",
              "label": "Week Strip",
              "description": "One circle per day, pink when you ticked something",
              "minWidth": "250dp",
              "minHeight": "40dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "maxResizeWidth": "500dp",
              "maxResizeHeight": "120dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-preview/week_strip.png"
            }
          ]
        }
      ]
    ],
    "scheme": "abacusai1791197654"
  }
}
